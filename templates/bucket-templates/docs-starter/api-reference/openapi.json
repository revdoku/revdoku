{
  "openapi": "3.1.0",
  "info": { "title": "Acme API", "version": "1.0.0", "description": "A sample API. Replace this file with your own OpenAPI document." },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "security": [{ "bearer": [] }],
  "tags": [{ "name": "Plants", "description": "The plants in your store." }],
  "paths": {
    "/plants": {
      "get": {
        "tags": ["Plants"], "summary": "List plants", "operationId": "listPlants",
        "parameters": [{ "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100 }, "description": "Most plants to return." }],
        "responses": { "200": { "description": "The plants", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Plant" } } } } } }
      },
      "post": {
        "tags": ["Plants"], "summary": "Add a plant", "operationId": "createPlant",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewPlant" } } } },
        "responses": { "201": { "description": "The new plant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Plant" } } } } }
      }
    },
    "/plants/{id}": {
      "get": {
        "tags": ["Plants"], "summary": "Get a plant", "operationId": "getPlant",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "The plant ID." }],
        "responses": { "200": { "description": "The plant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Plant" } } } }, "404": { "description": "No plant with this ID" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "NewPlant": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "description": "The plant's name." }, "tag": { "type": "string", "description": "An optional tag." } } },
      "Plant": { "allOf": [{ "$ref": "#/components/schemas/NewPlant" }, { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "description": "The plant ID." } } }] }
    }
  }
}
