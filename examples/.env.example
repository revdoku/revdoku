# Copy to .env and fill locally. Never commit real credentials.
REVDOKU_API_KEY=
# Select an existing mailbox for the read and upload examples.
REVDOKU_MAILBOX_ID=
# Optional: another account explicitly granted to this credential.
REVDOKU_ACCOUNT_ID=

# Returned by webhook-set. Keep private.
REVDOKU_WEBHOOK_SECRET=

# Optional for the customer-mailbox examples:
# REVDOKU_STATE_DIR=.revdoku-examples
# REVDOKU_EMAIL_DOMAIN=mail.example.com
