# ---------------------------------------------------------------------------
# Command parsing. The first non-option token is the verb (ls, files, read …);
# options may appear before or after it. A bare path (`revdoku .`) stores files;
# no args at all shows status + a hint. The most common verb is the shortest.
# ---------------------------------------------------------------------------
VERB_SEEN="false"
ORIGINAL_ARGC=$#

while [[ $# -gt 0 ]]; do
  case "$1" in
    --api-key)
      [[ $# -ge 2 ]] || die "--api-key requires a value"
      API_KEY="$2"
      shift 2
      ;;
    --webhook-url)
      [[ $# -ge 2 ]] || die "--webhook-url requires a value"
      WEBHOOK_URL="$2"; shift 2 ;;
    --rotate-secret) ROTATE_SECRET="true"; shift ;;
    --access-mode)
      [[ $# -ge 2 && "$2" =~ ^(public|password|require_email)$ ]] || die "--access-mode must be public, password or require_email"
      ACCESS_MODE="$2"; shift 2 ;;
    --password-file)
      [[ $# -ge 2 ]] || die "--password-file requires a path, or - for standard input"
      PASSWORD_FILE="$2"; shift 2 ;;
    --support)
      [[ $# -ge 2 && "$2" =~ ^(form|form_email|email|link|none)$ ]] || die "--support must be form, form_email, email, link or none"
      SUPPORT_HANDOFF="$2"; shift 2 ;;
    --email-allowlist)
      # Addresses and domains apart by commas; an empty value removes the list.
      [[ $# -ge 2 ]] || die "--email-allowlist requires a comma-separated list, or \"\" to remove it"
      EMAIL_ALLOWLIST="$2"; EMAIL_ALLOWLIST_SET="true"; shift 2 ;;
    --support-link)
      [[ $# -ge 2 && "$2" == https://* ]] || die "--support-link requires an https URL"
      SUPPORT_LINK="$2"; shift 2 ;;
    --preview) SITE_PREVIEW="true"; shift ;;
    --confirm-source-code) CONFIRM_SOURCE_CODE="true"; shift ;;
    --no-wait) WAIT_FOR_WORK="false"; shift ;;
    --read) DRAFT_READ="true"; shift ;;
    --stop) SCAN_STOP="true"; shift ;;
    --max-articles)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || die "--max-articles must be a whole number from 1"
      SCAN_MAX_ARTICLES="$2"; shift 2 ;;
    --branch|--repo-path|--installation-id)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "$1 requires a value"
      case "$1" in
        --branch) GITHUB_BRANCH="$2" ;;
        --repo-path) GITHUB_REPO_PATH="$2" ;;
        --installation-id) [[ "$2" =~ ^[1-9][0-9]{0,18}$ ]] || die "--installation-id must be the number from revdoku github accounts"; GITHUB_INSTALLATION_ID="$2" ;;
      esac
      shift 2 ;;
    --project-files)
      [[ $# -ge 2 && "$2" == "replace" ]] || die "--project-files is replace"
      GITHUB_PROJECT_FILES="$2"; shift 2 ;;
    --auto-publish)
      [[ $# -ge 2 && ( "$2" == "true" || "$2" == "false" ) ]] || die "$1 must be true or false"
      GITHUB_AUTO_PUBLISH="$2"
      shift 2 ;;
    --url)
      [[ $# -ge 2 ]] || die "--url requires a value"
      BASE_URL="$2"
      shift 2
      ;;
    --username|--domain)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "$1 requires a value"
      case "$1" in
        --username) EMAIL_USERNAME="$2" ;;
        --domain) EMAIL_DOMAIN="$2" ;;
      esac
      shift 2
      ;;
    --description)
      [[ $# -ge 2 ]] || die "--description requires a value"
      DESCRIPTION="$2"; DESCRIPTION_SET="true"
      shift 2
      ;;
    --title)
      [[ $# -ge 2 && -n "$2" ]] || die "--title requires a value"
      PROJECT_TITLE="$2"
      shift 2
      ;;
    --account-id)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "--account-id requires an account id"
      ACCOUNT_ID="$2"
      shift 2
      ;;
    --client-name)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "--client-name requires a client name"
      CLIENT_DISPLAY_NAME="$2"
      shift 2
      ;;
    --project-id)
      [[ $# -ge 2 ]] || die "--project-id requires a value"
      PROJECT_ID="$2"
      PROJECT_EXPLICIT="true"
      shift 2
      ;;
    --status|--query)
      [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value"
      # --status belongs to ls, tickets and ticket-update; the command decides its values after parsing.
      if [[ "$1" == "--status" ]]; then
        STATUS_OPTION="$2"
      else
        PROJECT_LIST_QUERY="$2"
        PROJECT_LIST_OPTIONS="true"
      fi
      shift 2
      ;;
    --cursor|--limit|--folder|--subject|--attachment-id|--version-id|--message-id|--channel|--label|--updated-after)
      [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value"
      case "$1" in
        --cursor) LIST_CURSOR="$2" ;;
        --folder) LIST_FOLDER="$2" ;;
        --limit) [[ "$2" =~ ^[1-9][0-9]*$ && "$2" -le 200 ]] || die "--limit must be from 1 to 200"; LIST_LIMIT="$2" ;;
        --version-id) VERSION_ID="$2" ;;
        --subject) EMAIL_SUBJECT="$2" ;;
        --attachment-id) EMAIL_ATTACHMENT_ID="$2" ;;
        --message-id) [[ "$2" =~ ^eml_[A-Za-z0-9]+$ ]] || die "--message-id requires a message id (eml_...)"; MESSAGE_ID="$2" ;;
        --channel) [[ "$2" =~ ^(email|chat|feedback)$ ]] || die "--channel must be email, chat or feedback"; TICKET_CHANNEL="$2" ;;
        --label) TICKET_LABEL="$2" ;;
        --updated-after) TICKET_UPDATED_AFTER="$2" ;;
      esac
      shift 2
      ;;
    --note)
      # An empty text is a value here: it removes the note.
      [[ $# -ge 2 ]] || die "--note requires a value"
      TICKET_NOTE="$2"; TICKET_NOTE_SET="true"
      shift 2
      ;;
    --expected-note)
      # An empty text is a value here: the ticket had no note when it was read.
      [[ $# -ge 2 ]] || die "--expected-note requires a value"
      TICKET_EXPECTED_NOTE="$2"; TICKET_EXPECTED_NOTE_SET="true"
      shift 2
      ;;
    --expected-project-version)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "--expected-project-version requires a project version id"
      EXPECTED_PROJECT_VERSION="$2"
      shift 2
      ;;
    --attach|--text|--text-file|--html-file|--add-label|--remove-label)
      [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value"
      case "$1" in
        --attach|--add-label|--remove-label)
          [[ "$2" != *$'\n'* ]] || die "$1 requires a single value" ;;
      esac
      case "$1" in
        --add-label) EMAIL_ADD_LABELS+="$2"$'\n' ;;
        --remove-label) EMAIL_REMOVE_LABELS+="$2"$'\n' ;;
        --attach) [[ "$2" =~ ^df_[A-Za-z0-9]+$ ]] || die "--attach requires a project file id"; EMAIL_ATTACHMENTS+="$2"$'\n' ;;
        --text) EMAIL_TEXT="$2" ;;
        --text-file) EMAIL_TEXT_FILE="$2" ;;
        --html-file) EMAIL_HTML_FILE="$2" ;;
      esac
      shift 2
      ;;
    --metadata)
      [[ $# -ge 2 ]] || die "--metadata requires a JSON object"
      METADATA_JSON="$2"
      shift 2
      ;;
    --agent)
      [[ $# -ge 2 ]] || die "--agent requires a value"
      AGENT_NAME="$2"
      shift 2
      ;;
    --output)
      [[ $# -ge 2 ]] || die "--output requires a value"
      OUTPUT_PATH="$2"
      shift 2
      ;;
    --file)
      [[ $# -ge 2 ]] || die "--file requires a value"
      LOCAL_FILE="$2"
      shift 2
      ;;
    --reason)
      [[ $# -ge 2 ]] || die "--reason requires a value"
      ACTION_REASON="$2"
      shift 2
      ;;
    --confirm-delete)
      [[ $# -ge 2 && -n "$2" ]] || die "--confirm-delete requires a preview token"
      DELETE_CONFIRMATION="$2"
      shift 2
      ;;
    --version)
      printf '%s\n' "$(installed_client_version)"
      printf 'Releases: https://github.com/revdoku/revdoku/releases\n' >&2
      exit 0
      ;;
    --login)
      # Compatibility with older public prompts. `revdoku login` is the
      # canonical spelling, but existing copied instructions must keep working.
      LOGIN="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "unknown option: $1 (run 'revdoku --help')"
      ;;
    *)
      # The addresses of scan and the word set of settings may come before or after the options.
      if [[ "$VERB_SEEN" == "true" && "$ACTION" == "website_scan" ]]; then
        SCAN_URLS+="$1"$'\n'; shift
      elif [[ "$VERB_SEEN" == "true" && "$ACTION" == "settings" && "$SETTINGS_ACTION" == "get" && "$1" == "set" ]]; then
        SETTINGS_ACTION="set"; shift
      elif [[ "$VERB_SEEN" == "true" ]]; then
        die "unexpected positional argument"
      else
        VERB_SEEN="true"
        case "$1" in
          upload|put|append)
            die "Write a knowledge base file with: revdoku write _kb/private/NAME.md --file FILE. The files of _repo/ come from the GitHub repository. Change the files on GitHub." ;;
          write)          [[ $# -ge 2 && "$2" != -* ]] || die "write needs a project PATH right after it, e.g. revdoku write _kb/private/refunds.md --file refunds.md"; ACTION="write_file"; READ_FILE_PATH="$2"; shift 2 ;;
          mv)             [[ $# -ge 3 && "$2" != -* && "$3" != -* ]] || die "mv needs the file's PATH and its NEW_PATH, e.g. revdoku mv _kb/private/a.md _kb/public/a.md"; ACTION="move_file"; READ_FILE_PATH="$2"; NEW_FILE_PATH="$3"; shift 3 ;;
          rm)             [[ $# -ge 2 && "$2" != -* ]] || die "rm needs a project PATH right after it, e.g. revdoku rm _kb/private/old.md"; ACTION="delete_file"; READ_FILE_PATH="$2"; shift 2 ;;
          restore)        [[ $# -ge 2 && "$2" != -* ]] || die "restore needs a project PATH right after it, e.g. revdoku restore _kb/private/a.md --version-id ID"; ACTION="restore_file"; READ_FILE_PATH="$2"; shift 2 ;;
          publish|preview|site) ACTION="$1"; shift ;;
          # The site settings: read them, or change the fields of a JSON object (settings set --file FILE).
          settings)
            shift; ACTION="settings"; SETTINGS_ACTION="get"
            if [[ "${1:-}" == "set" ]]; then SETTINGS_ACTION="set"; shift; fi ;;
          # A website scan: scan URL... starts one; --read reads the newest; --stop stops the one that runs.
          scan)
            shift; ACTION="website_scan"
            while [[ $# -ge 1 && "$1" != -* ]]; do SCAN_URLS+="$1"$'\n'; shift; done ;;
          update)         ACTION="update_project"; shift ;;
          unpublish|down) ACTION="unpublish"; shift ;;
          github)
            shift
            ACTION="github"; GITHUB_ACTION="get"
            case "${1:-}" in
              accounts|setup-link|set|sync|disconnect|branches) GITHUB_ACTION="$1"; shift ;;
              repos)
                [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]{0,18}$ ]] || die "github repos needs an installation ID from revdoku github accounts"
                GITHUB_ACTION="repos"; GITHUB_INSTALLATION_ID="$2"; shift 2 ;;
              connect)
                [[ $# -ge 2 && "$2" =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$ ]] || die "github connect needs OWNER/NAME, for example acme/docs"
                GITHUB_ACTION="connect"; GITHUB_REPOSITORY="$2"; shift 2 ;;
              scan)
                GITHUB_ACTION="scan"; shift
                # Without OWNER/NAME the scan reads the connected repository.
                if [[ $# -ge 1 && "$1" != -* ]]; then
                  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$ ]] || die "github scan takes OWNER/NAME, for example acme/docs"
                  GITHUB_REPOSITORY="$1"; shift
                fi ;;
            esac
            ;;
          # Removed names answer what replaced them.
          p)              die "The command p was removed. Use revdoku publish." ;;
          sites)          die "revdoku sites was removed. Use revdoku ls for the projects and revdoku site for the site of one." ;;
          analytics)      die "revdoku analytics was removed. Read GET /v1/projects/PROJECT_ID/analytics: https://support.revdoku.com/docs/api" ;;
          i|init)         die "revdoku init was removed. Use revdoku create, then revdoku github connect OWNER/NAME." ;;
          ls|list)        ACTION="list_projects"; shift ;;
          accounts)       ACTION="list_accounts"; shift ;;
          create)         ACTION="create_project"; shift ;;
          o|open)         ACTION="open_dashboard"; shift ;;
          st|status)      ACTION="connection_status"; shift ;;
          login)          LOGIN="true"; shift ;;
          grant)          [[ $# -ge 2 && "$2" != -* ]] || die "grant needs the one-time token right after it"; ACTION="exchange_grant"; GRANT_TOKEN="$2"; shift 2 ;;
          webhook|webhook-set|webhook-delete|events-subscription) ACTION="$1"; shift ;;
          tickets)        ACTION="list_tickets"; shift ;;
          ticket|ticket-messages|ticket-reply|ticket-draft|ticket-update|ticket-download|ticket-message-delete)
            [[ $# -ge 2 && "$2" =~ ^tkt_[A-Za-z0-9]+$ ]] || die "$1 requires a ticket id (tkt_...); see revdoku tickets"
            ACTION="$1"; TICKET_ID="$2"; shift 2 ;;
          files)          ACTION="list_files"; shift ;;
          read)           [[ $# -ge 2 && "$2" != -* ]] || die "read needs a project PATH right after it, e.g. revdoku read notes.md --project-id ID"; ACTION="read_file"; READ_FILE_PATH="$2"; shift 2 ;;
          versions)       [[ $# -ge 2 && "$2" != -* ]] || die "versions needs a project PATH right after it, e.g. revdoku versions notes.md --project-id ID"; ACTION="list_versions"; READ_FILE_PATH="$2"; shift 2 ;;
          archive)        ACTION="archive_project"; shift ;;
          unarchive)      ACTION="unarchive_project"; shift ;;
          delete)         ACTION="delete_project"; shift ;;
          account)
            shift
            if [[ "${1:-}" == "create-client" ]]; then
              [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "account create-client needs a name"
              ACTION="create_client_account"; CLIENT_ACCOUNT_NAME="$2"; shift 2
            elif [[ "${1:-}" == "limits" ]]; then
              ACTION="account_limits"; shift
            elif [[ "${1:-}" == "get" ]]; then
              [[ $# -ge 2 && "$2" =~ ^acct_[A-Za-z0-9]+$ ]] || die "account get needs an account id"
              ACTION="get_account"; ACCOUNT_DETAILS_ID="$2"; shift 2
            else
              ACTION="account_status"
            fi
            ;;
          dashboard)      ACTION="open_dashboard"; shift ;;
          help)           usage; exit 0 ;;
          version)        printf '%s\n' "$(installed_client_version)"; exit 0 ;;
          *)
            die "unknown command: $1 (run 'revdoku --help')"
            ;;
        esac
      fi
      ;;
  esac
done

# No arguments shows the connection status.
if [[ -z "$ACTION" && "$LOGIN" != "true" ]]; then
  [[ "$ORIGINAL_ARGC" -eq 0 ]] || die "Choose a command (run 'revdoku --help')"
  ACTION="connection_status"
fi

BASE_URL="${BASE_URL%/}"
validate_base_url
[[ -z "$DELETE_CONFIRMATION" || "$ACTION" == "delete_project" || "$ACTION" == "ticket-message-delete" || "$ACTION" == "webhook-delete" || "$GITHUB_ACTION" == "disconnect" ]] || die "--confirm-delete is only available with delete, ticket-message-delete, webhook-delete or github disconnect"
if [[ ( -n "$WEBHOOK_URL" || "$ROTATE_SECRET" == "true" ) && "$ACTION" != "webhook-set" ]]; then
  die "--webhook-url and --rotate-secret require webhook-set"
fi
[[ "$TICKET_NOTE_SET" != "true" || "$ACTION" == "ticket-update" ]] || die "--note requires ticket-update"
[[ "$TICKET_EXPECTED_NOTE_SET" != "true" || ( "$ACTION" == "ticket-update" && "$TICKET_NOTE_SET" == "true" ) ]] || die "--expected-note requires ticket-update with --note"
case "$ACTION" in
  write_file|move_file|delete_file|restore_file) ;;
  *) [[ -z "$EXPECTED_PROJECT_VERSION" ]] || die "--expected-project-version requires write, mv, rm or restore" ;;
esac
[[ -z "$LIST_FOLDER" || "$ACTION" == "list_files" ]] || die "--folder requires files"
if [[ -n "$EMAIL_ATTACHMENTS$EMAIL_SUBJECT$EMAIL_TEXT$EMAIL_TEXT_FILE$EMAIL_HTML_FILE" && "$ACTION" != "ticket-reply" ]]; then
  die "--attach, --subject, --text, --text-file and --html-file require ticket-reply"
fi
[[ -z "$EMAIL_ADD_LABELS$EMAIL_REMOVE_LABELS" || "$ACTION" == "ticket-update" ]] || die "--add-label and --remove-label require ticket-update"
[[ -z "$TICKET_CHANNEL$TICKET_LABEL$TICKET_UPDATED_AFTER" || "$ACTION" == "list_tickets" ]] || die "--channel, --label and --updated-after require tickets"
case "$ACTION" in
  ticket-messages|ticket-download|ticket-message-delete) ;;
  *) [[ -z "$MESSAGE_ID" ]] || die "--message-id requires ticket-messages, ticket-download or ticket-message-delete" ;;
esac
[[ -z "$EMAIL_ATTACHMENT_ID" || "$ACTION" == "ticket-download" ]] || die "--attachment-id requires ticket-download"
if [[ -n "$STATUS_OPTION" ]]; then
  case "$ACTION" in
    list_projects)
      [[ "$STATUS_OPTION" =~ ^(active|archived|all)$ ]] || die "--status must be active, archived or all"
      PROJECT_LIST_STATUS="$STATUS_OPTION" ;;
    list_tickets) [[ "$STATUS_OPTION" =~ ^(open|pending|solved|all)$ ]] || die "--status must be open, pending, solved or all" ;;
    ticket-update) [[ "$STATUS_OPTION" =~ ^(open|pending|solved)$ ]] || die "--status must be open, pending or solved" ;;
    *) die "--status requires ls, tickets or ticket-update" ;;
  esac
fi
if [[ "$PROJECT_LIST_OPTIONS" == "true" && "$ACTION" != "list_projects" ]]; then
  die "--query requires ls or list"
fi
case "$ACTION:$GITHUB_ACTION" in
  list_projects:|list_files:|list_tickets:|ticket-messages:|list_versions:|github:accounts|github:repos|github:branches) ;;
  *) [[ -z "$LIST_LIMIT$LIST_CURSOR" ]] || die "--limit and --cursor require ls, files, tickets, ticket-messages, versions, github accounts, github repos or github branches" ;;
esac
# Each GitHub option belongs to one or two github commands, so none is silently ignored.
[[ -z "$GITHUB_BRANCH" || "$GITHUB_ACTION" == "connect" || "$GITHUB_ACTION" == "scan" || "$ACTION" == "preview" ]] || die "--branch requires github connect, github scan or preview"
[[ -z "$GITHUB_REPO_PATH" && ( -z "$GITHUB_INSTALLATION_ID" || "$GITHUB_ACTION" == "repos" ) || "$GITHUB_ACTION" == "connect" || "$GITHUB_ACTION" == "scan" ]] ||
  die "--repo-path and --installation-id require github connect or github scan"
[[ -z "$CONFIRM_SOURCE_CODE" || "$ACTION" == "publish" ]] || die "--confirm-source-code works with publish only"
[[ -z "$GITHUB_AUTO_PUBLISH" || "$GITHUB_ACTION" == "set" ]] || die "--auto-publish requires github set"
[[ -z "$GITHUB_PROJECT_FILES" || "$GITHUB_ACTION" == "connect" ]] || die "--project-files requires github connect"
if [[ -n "$VERSION_ID" && "$ACTION" != "read_file" && "$ACTION" != "restore_file" ]]; then
  die "--version-id requires read or restore"
fi
[[ -z "$LOCAL_FILE" || "$ACTION" == "write_file" || "$SETTINGS_ACTION" == "set" ]] || die "--file requires write or settings set"
[[ "$DRAFT_READ" != "true" || "$ACTION" == "ticket-draft" || "$ACTION" == "website_scan" ]] || die "--read requires ticket-draft or scan"
[[ "$SCAN_STOP" != "true" && -z "$SCAN_MAX_ARTICLES" || "$ACTION" == "website_scan" ]] || die "--stop and --max-articles require scan"
if [[ "$ACTION" == "website_scan" ]]; then
  # One choice: start (addresses), --read or --stop.
  scan_choices=0
  [[ -z "$SCAN_URLS" ]] || scan_choices=$((scan_choices + 1))
  [[ "$DRAFT_READ" != "true" ]] || scan_choices=$((scan_choices + 1))
  [[ "$SCAN_STOP" != "true" ]] || scan_choices=$((scan_choices + 1))
  [[ "$scan_choices" -eq 1 ]] || die "scan takes website addresses (scan acme.com), --read or --stop"
  [[ -z "$SCAN_MAX_ARTICLES" || -n "$SCAN_URLS" ]] || die "--max-articles requires scan with addresses"
fi
if [[ -n "$EMAIL_USERNAME$EMAIL_DOMAIN" && "$ACTION" != "create_project" ]]; then
  die "--username and --domain require create"
fi
if [[ -n "$PROJECT_TITLE" && "$ACTION" != "create_project" && "$ACTION" != "update_project" ]]; then
  die "--title requires create or update"
fi
[[ "$DESCRIPTION_SET" != "true" || "$ACTION" == "create_project" || "$ACTION" == "update_project" ]] || die "--description requires create or update"
if [[ "$ACTION" == "delete_project" ]]; then
  [[ "$PROJECT_EXPLICIT" == "true" && -n "$PROJECT_ID" && -n "$ACCOUNT_ID" ]] || die "delete requires explicit --account-id and --project-id"
fi
[[ -n "$AGENT_NAME" ]] || AGENT_NAME="$(detect_agent_name)"

need_cmd curl
need_cmd openssl
need_cmd base64
need_cmd find

if [[ -x "${SCRIPT_DIR}/jq" ]]; then
  JQ_BIN="${SCRIPT_DIR}/jq"
elif command -v jq >/dev/null 2>&1; then
  JQ_BIN="$(command -v jq)"
else
  die "requires jq"
fi

ACTION_REASON="$("$JQ_BIN" -rn --arg reason "$ACTION_REASON" '$reason | gsub("^\\s+|\\s+$"; "")')"
"$JQ_BIN" -en --arg reason "$ACTION_REASON" '$reason | length <= 2000' >/dev/null || die "--reason must be 2000 characters or fewer"

API_KEY_FROM_CREDENTIALS="false"
if [[ -z "$API_KEY" && -f "$CREDENTIALS_PATH" ]]; then
  [[ ! -L "$CREDENTIALS_PATH" ]] || die "refusing symlink credentials"
  CREDENTIALS_PATH="$(local_file_path "$CREDENTIALS_PATH")"
  [[ ! -L "$CREDENTIALS_PATH" ]] || die "refusing symlink credentials"
  API_KEY_FROM_CREDENTIALS="true"
  API_KEY="$(tr -d '\r\n' < "$CREDENTIALS_PATH")"
fi

if [[ -z "$PROJECT_ID" && "$API_KEY_FROM_CREDENTIALS" == "true" && -f "$DEFAULT_PROJECT_PATH" ]]; then
  [[ ! -L "$DEFAULT_PROJECT_PATH" ]] || die "refusing symlink project selection"
  PROJECT_ID="$(tr -d '\r\n' < "$DEFAULT_PROJECT_PATH")"
fi

# Earlier releases read REVDOKU_MAILBOX_ID. Stop rather than create a new project.
if [[ -n "${REVDOKU_MAILBOX_ID:-}" && -z "${REVDOKU_PROJECT_ID:-}" && "$PROJECT_EXPLICIT" != "true" ]]; then
  die "Rename REVDOKU_MAILBOX_ID to REVDOKU_PROJECT_ID, or use --project-id."
fi
# A .revdoku file binds this folder to a project for read commands.
# An explicit --project-id takes precedence.
if [[ -d "$PATH_TO_STORE" || ! -e "$PATH_TO_STORE" ]]; then
  REVDOKU_PROJECT_FILE="${PATH_TO_STORE%/}/.revdoku"
else
  REVDOKU_PROJECT_FILE="$(dirname "$PATH_TO_STORE")/.revdoku"
fi
[[ ! -L "$REVDOKU_PROJECT_FILE" ]] || die "refusing symlink project binding"
if [[ -f "$REVDOKU_PROJECT_FILE" ]]; then
  BINDING_EXISTED="true"
  # Earlier releases wrote mailbox_id=. Stop rather than create a new project for this folder.
  if [[ "$PROJECT_EXPLICIT" != "true" ]] && LC_ALL=C grep -q '^mailbox_id=' "$REVDOKU_PROJECT_FILE"; then
    die "Replace mailbox_id with project_id in .revdoku, or use --project-id."
  fi
  BOUND_PROJECT_ID="$(sed -n 's/^project_id=//p' "$REVDOKU_PROJECT_FILE" 2>/dev/null | head -n1 | tr -d '\r')"
fi
if [[ -z "$PROJECT_ID" && -n "$BOUND_PROJECT_ID" ]]; then
  PROJECT_ID="$BOUND_PROJECT_ID"
fi
[[ -z "$PROJECT_ID" ]] || validate_id project_id "$PROJECT_ID"
[[ -z "$ACCOUNT_ID" ]] || validate_id account_id "$ACCOUNT_ID"
[[ -z "$VERSION_ID" ]] || validate_id version_id "$VERSION_ID"
[[ -z "$EXPECTED_PROJECT_VERSION" ]] || validate_id expected_project_version "$EXPECTED_PROJECT_VERSION"
for header_value in "$API_KEY" "$AGENT_NAME" "$AGENT_CLIENT" "$AGENT_VERSION" "$AGENT_RUN_ID" "$AGENT_TASK"; do
  [[ "$header_value" != *[[:cntrl:]]* ]] || die "control characters are not allowed in request headers"
done
if [[ -n "$METADATA_JSON" ]]; then
  METADATA_JSON="$(printf "%s" "$METADATA_JSON" | "$JQ_BIN" -c 'if type == "object" then . else error("metadata must be a JSON object") end')" || die "--metadata must be a JSON object"
else
  METADATA_JSON="{}"
fi

account_request_path() {
  local request_path="$1" separator="?"
  if [[ -n "$ACCOUNT_ID" && "$request_path" == /api/v1/* ]]; then
    [[ "$request_path" != *\?* ]] || separator="&"
    printf '%s%saccount_id=%s' "$request_path" "$separator" "$("$JQ_BIN" -rn --arg id "$ACCOUNT_ID" '$id|@uri')"
  else
    printf '%s' "$request_path"
  fi
}

api_url() {
  [[ "$1" == /* && "$1" != //* && "$1" != *[[:space:][:cntrl:]\\]* && "$1" != *'#'* ]] || die "invalid API path"
  if [[ "$BASE_URL" == "$DEFAULT_URL" && "$1" == /api/v1/* ]]; then
    printf "%s%s" "$BASE_URL" "${1#/api}"
  else
    printf "%s%s" "$APP_URL" "$1"
  fi
}

json_string() {
  "$JQ_BIN" -rn --arg value "$1" '$value'
}

http_status_success() {
  local status="${1:-}"
  [[ "$status" =~ ^[0-9]+$ ]] && (( status >= 200 && status < 300 ))
}

# A 429 is never a transient error: only the rate-limit branch of http_json handles it, and a long wait or a plan
# limit is told, not retried.
http_status_retryable() {
  case "${1:-}" in
    408|425|500|502|503|504)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

http_error_code_retryable() {
  case "${1:-}" in
    DATABASE_BUSY_RETRY|PROJECT_DELETE_BUSY|PROJECT_DELETE_ENQUEUE_FAILED)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

retry_delay_for_attempt() {
  local attempt="${1:-1}"
  local retry_after="${2:-}"
  local delay
  if [[ "$retry_after" =~ ^[0-9]+$ && "$retry_after" -gt 0 ]]; then
    echo "$retry_after"
    return 0
  fi
  case "$attempt" in
    1) delay=1 ;;
    2) delay=2 ;;
    3) delay=4 ;;
    *) delay=8 ;;
  esac
  echo "$delay"
}

http_success_json_replay_allowed() {
  local method="$1"
  local path="$2"
  case "$method:$path" in
    GET:*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

http_conflict_retry_allowed() {
  local method="$1"
  local path="$2"
  case "$method:$path" in
    GET:*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

http_lock_retry_allowed() {
  return 1
}

lock_detail_summary() {
  local details_json="${1:-{}}"
  "$JQ_BIN" -r '
    def present: select(. != null and . != "");
    (.locked_by_api_key.label // .locked_by.name // .locked_by.email // .locked_by_api_key.id // .locked_by.id // "another actor") as $owner
    | (.message // .kind // "" | tostring) as $message
    | (.expires_at // "" | tostring) as $until
    | "locked by " + $owner
      + (if ($message | length) > 0 then " (" + $message + ")" else "" end)
      + (if ($until | length) > 0 then " until " + $until else "" end)
  ' <<<"$details_json" 2>/dev/null || printf 'locked by another actor'
}

agent_header_args() {
  printf "%s\0" \
    "-H" "User-Agent: Revdoku/${AGENT_VERSION} (${AGENT_CLIENT})" \
    "-H" "X-Revdoku-Agent: ${AGENT_NAME}" \
    "-H" "X-Revdoku-Agent-Client: ${AGENT_CLIENT}" \
    "-H" "X-Revdoku-Agent-Version: ${AGENT_VERSION}"
  [[ -n "$AGENT_RUN_ID" ]] && printf "%s\0" "-H" "X-Revdoku-Agent-Run-Id: ${AGENT_RUN_ID}"
  [[ -n "$AGENT_TASK" ]] && printf "%s\0" "-H" "X-Revdoku-Agent-Task: ${AGENT_TASK}"
}

reason_request_path() {
  local path="$1" separator="?"
  if [[ -n "$ACTION_REASON" ]]; then
    [[ "$path" != *\?* ]] || separator="&"
    path="${path}${separator}reason=$("$JQ_BIN" -rn --arg value "$ACTION_REASON" '$value | @uri')"
  fi
  printf '%s' "$path"
}

http_json() {
  local method="$1"
  local path="$2"
  local payload="$3"
  local auth="${4:-true}"
  local HTTP_TRANSIENT_MAX_ATTEMPTS="$HTTP_TRANSIENT_MAX_ATTEMPTS"
  [[ "$method" != "DELETE" ]] || HTTP_TRANSIENT_MAX_ATTEMPTS=0
  # Creation has no replay key. A lost or failed response may follow a commit.
  if [[ "$method" == "POST" && "$path" == "/api/v1/projects" ]]; then
    HTTP_TRANSIENT_MAX_ATTEMPTS=0
  fi
  # Never send a ticket reply, a publish, a GitHub connect or a website scan twice: a publish may already be queued and charged after a
  # lost response, and a connect may already copy the repository. Rate limits also return without a retry
  # (the hourly publish limit waits an hour).
  local send_once="false"
  if [[ "$method" == "POST" && "$path" =~ ^/api/v1/projects/[^/?]+/(tickets/[^/?]+/(messages|draft)|publication(/preview)?|github|website_scan)$ ]]; then
    HTTP_TRANSIENT_MAX_ATTEMPTS=0
    send_once="true"
  fi
  # A client account has no replay key, a connection token works once, and a webhook answers a new secret once.
  if [[ ( "$method" == "POST" && "$path" =~ ^/api/v1/(accounts|auth/grant/exchange)$ ) || ( "$method" == "PUT" && "$path" =~ ^/api/v1/projects/[^/?]+/webhook$ ) ]]; then
    HTTP_TRANSIENT_MAX_ATTEMPTS=0
    send_once="true"
  fi
  if [[ -n "$ACCOUNT_ID" && "$auth" == "true" && "$path" == /api/v1/* ]]; then
    if [[ "$method" == "GET" || "$method" == "HEAD" || "$method" == "DELETE" ]]; then
      path="$(account_request_path "$path")"
    else
      payload="$("$JQ_BIN" -c --arg account_id "$ACCOUNT_ID" '. + {account_id: $account_id}' <<<"$payload")"
    fi
  fi
  if [[ -n "$ACTION_REASON" && "$auth" == "true" && "$path" == /api/v1/* ]]; then
    if [[ "$method" == "GET" || "$method" == "HEAD" || "$method" == "DELETE" ]]; then
      path="$(reason_request_path "$path")"
    else
      payload="$("$JQ_BIN" -c --arg reason "$ACTION_REASON" '. + {reason: $reason}' <<<"$payload")"
    fi
  fi
  local body_file status message code request_id retry_after details_json upgrade_url next_action browser_url attempt curl_status delay agent_args=()
  LAST_HTTP_STATUS=""
  LAST_ERROR_CODE=""
  LAST_ERROR_MESSAGE=""
  LAST_ERROR_DETAILS_JSON=""
  body_file="$(mktemp)"
  attempt=0

  while IFS= read -r -d '' value; do
    agent_args+=("$value")
  done < <(agent_header_args)

  local args=(-sS -o "$body_file" -w "%{http_code}" -X "$method" --url "$(api_url "$path")" "${agent_args[@]}" -H "Content-Type: application/json")
  if [[ "$auth" == "true" ]]; then
    args+=(-H "Authorization: Bearer $API_KEY")
  fi
  # Read the body from stdin: one command-line argument is limited to 128 KiB on Linux.
  args+=(--data-binary @-)

  while true; do
    : > "$body_file"
    if status="$(printf '%s' "$payload" | safe_curl "${args[@]}")"; then
      curl_status=0
    else
      curl_status=$?
      if (( attempt < HTTP_TRANSIENT_MAX_ATTEMPTS )); then
        attempt=$((attempt + 1))
        delay="$(retry_delay_for_attempt "$attempt")"
        echo "Network error while calling $path; retrying in ${delay}s (${attempt}/${HTTP_TRANSIENT_MAX_ATTEMPTS})..." >&2
        sleep "$delay"
        continue
      fi
      rm -f "$body_file"
      LAST_HTTP_STATUS=""
      LAST_ERROR_CODE=""
      LAST_ERROR_MESSAGE="Network error while calling $path"
      LAST_ERROR_DETAILS_JSON=""
      echo "error: network error while calling $path (curl exit $curl_status)" >&2
      return 1
    fi

    if http_status_success "$status"; then
      if [[ "$status" != "204" ]] && ! "$JQ_BIN" -e . "$body_file" >/dev/null 2>&1; then
        if http_success_json_replay_allowed "$method" "$path" && (( attempt < HTTP_TRANSIENT_MAX_ATTEMPTS )); then
          attempt=$((attempt + 1))
          delay="$(retry_delay_for_attempt "$attempt")"
          echo "Invalid JSON response from $path after HTTP $status; retrying in ${delay}s (${attempt}/${HTTP_TRANSIENT_MAX_ATTEMPTS})..." >&2
          sleep "$delay"
          continue
        fi
        rm -f "$body_file"
        LAST_HTTP_STATUS="$status"
        LAST_ERROR_CODE="INVALID_JSON_RESPONSE"
        LAST_ERROR_MESSAGE="Invalid JSON response from $path after HTTP $status"
        LAST_ERROR_DETAILS_JSON=""
        echo "error: invalid JSON response from $path after HTTP $status" >&2
        return 1
      fi
      cat "$body_file"
      rm -f "$body_file"
      return 0
    fi

    message="$("$JQ_BIN" -r '.error.message // .error_description // .message // empty' "$body_file" 2>/dev/null || true)"
    code="$("$JQ_BIN" -r '.error.code // .error // empty' "$body_file" 2>/dev/null || true)"
    request_id="$("$JQ_BIN" -r '.error.request_id // .request_id // empty' "$body_file" 2>/dev/null || true)"
    retry_after="$("$JQ_BIN" -r '.error.details.retry_after_seconds // empty' "$body_file" 2>/dev/null || true)"
    details_json="$("$JQ_BIN" -c '.error.details // {}' "$body_file" 2>/dev/null || printf '{}')"
    next_action="$("$JQ_BIN" -r '.error.next_action? // empty | strings | select(test("^[a-z_]{1,64}$"))' "$body_file" 2>/dev/null || true)"
    browser_url="$("$JQ_BIN" -r '.error.browser_url? // empty | strings | select(test("^https://[^\\s\\p{Cc}]+$"))' "$body_file" 2>/dev/null || true)"

    # Plan limits also answer 429 (for example PROJECT_CREATION_LIMIT_REACHED); only rate limits clear on retry.
    # A wait above a minute (a sign-in code limit, a daily limit) is told, not slept through.
    if [[ "$method" != "DELETE" && "$send_once" != "true" && "$status" == "429" && "$attempt" -lt 20 ]] &&
      [[ -z "$code" || "$code" == *RATE_LIMIT* ]] && [[ ! "$retry_after" =~ ^[0-9]+$ || "$retry_after" -le 60 ]]; then
      [[ "$retry_after" =~ ^[0-9]+$ && "$retry_after" -gt 0 ]] || retry_after=5
      attempt=$((attempt + 1))
      echo "Rate limited while calling $path; retrying in ${retry_after}s..." >&2
      sleep "$retry_after"
      continue
    fi

    if [[ "$method" != "DELETE" && "$status" == "409" ]] && http_error_code_retryable "$code" && http_conflict_retry_allowed "$method" "$path" && (( attempt < HTTP_RETRYABLE_CONFLICT_MAX_ATTEMPTS )); then
      attempt=$((attempt + 1))
      delay="$(retry_delay_for_attempt "$attempt" "$retry_after")"
      echo "Server is busy while calling $path; retrying in ${delay}s (${attempt}/${HTTP_RETRYABLE_CONFLICT_MAX_ATTEMPTS})..." >&2
      sleep "$delay"
      continue
    fi

    if [[ "$status" == "423" && ( "$code" == "PROJECT_LOCKED" || "$code" == "FILE_LOCKED" ) ]] && http_lock_retry_allowed "$method" "$path" && (( attempt < HTTP_LOCK_MAX_ATTEMPTS )); then
      attempt=$((attempt + 1))
      delay="$(retry_delay_for_attempt "$attempt" "$retry_after")"
      echo "Locked while calling $path ($(lock_detail_summary "$details_json")); retrying in ${delay}s (${attempt}/${HTTP_LOCK_MAX_ATTEMPTS})..." >&2
      sleep "$delay"
      continue
    fi

    if http_status_retryable "$status" && (( attempt < HTTP_TRANSIENT_MAX_ATTEMPTS )); then
      attempt=$((attempt + 1))
      delay="$(retry_delay_for_attempt "$attempt")"
      echo "Transient HTTP $status while calling $path; retrying in ${delay}s (${attempt}/${HTTP_TRANSIENT_MAX_ATTEMPTS})..." >&2
      sleep "$delay"
      continue
    fi

    rm -f "$body_file"
    LAST_HTTP_STATUS="$status"
    LAST_ERROR_CODE="$code"
    LAST_ERROR_MESSAGE="$message"
    LAST_ERROR_DETAILS_JSON="$details_json"
    [[ -n "$message" ]] || message="HTTP $status"
    [[ -n "$code" ]] && message="${message} (${code})"
    [[ -n "$request_id" ]] && message="${message} request_id=${request_id}"
    echo "error: $message" >&2
    upgrade_url="$("$JQ_BIN" -r '.upgrade_url? // empty | strings | select(test("^https?://[^\\s\\p{Cc}]+$"))' <<<"$details_json" 2>/dev/null || true)"
    [[ -z "$upgrade_url" ]] || echo "Upgrade: $upgrade_url" >&2
    # What the caller does next (error.next_action), for example upgrade_plan or retry_after_delay.
    [[ -z "$next_action" ]] || echo "Next action: $next_action" >&2
    # The page of that action for a person, when it is not the upgrade link above.
    [[ -z "$browser_url" || "$browser_url" == "$upgrade_url" ]] || echo "Open: $browser_url" >&2
    # A person's step on GitHub (GITHUB_APP_NOT_INSTALLED, GITHUB_SYNC_REPO_UNAVAILABLE): the links to give them.
    "$JQ_BIN" -r '[["Install the Revdoku GitHub App", .install_url?], ["Or connect a GitHub account that has it", .authorization_url?],
      ["Give the App access on GitHub", .settings_url?]][] | select((.[1] | type) == "string" and (.[1] | test("^https://[^\\s\\p{Cc}]+$")))
      | "\(.[0]): \(.[1])"' <<<"$details_json" >&2 2>/dev/null || true
    if [[ "$status" == "423" && ( "$code" == "PROJECT_LOCKED" || "$code" == "FILE_LOCKED" ) ]]; then
      echo "Lock details: $(lock_detail_summary "$details_json")" >&2
    fi
    if [[ "$auth" == "true" ]]; then
      if [[ "$code" == "ACCOUNT_ACCESS_UNAVAILABLE" ]]; then
        echo "This connection uses project-scoped agent credentials, which cannot read account-level status. Verify the connection with 'revdoku status', or open Revdoku in a browser for account details." >&2
      elif [[ "$status" == "401" ]]; then
        # Only a refused key. A 403 is a missing permission or a plan limit: a new sign-in does not change it.
        echo "Run 'revdoku login' to reconnect and save a fresh Revdoku API key." >&2
      fi
    fi
    return 1
  done
}

# Background work has one contract (WorkStatus): the resource of a start says status queued or processing, and a
# read of the same resource says ready or failed, with error {code, message}. This prints the answer of the start
# with the resource as it is at the end. Exit 0: ready. 1: failed. 2: it still runs after the wait.
wait_for_work() {
  local path="$1" key="$2" first="$3" response="$3" status waiting shown="" started="$SECONDS"
  if [[ "$WAIT_FOR_WORK" != "true" ]]; then
    printf '%s\n' "$first"
    return 0
  fi
  while true; do
    # A resource that is not there yet reads as null. Work that was started is not done then: wait for it.
    if "$JQ_BIN" -e --arg key "$key" '.data[$key] == null' <<<"$response" >/dev/null; then
      status="queued"
    else
      status="$("$JQ_BIN" -r --arg key "$key" '.data[$key].status? // empty' <<<"$response")"
    fi
    case "$status" in
      queued|processing) ;;
      *)
        "$JQ_BIN" -c --arg key "$key" --argjson last "$response" '.data[$key] = $last.data[$key]' <<<"$first"
        [[ "$status" == "failed" ]] || return 0
        echo "error: $("$JQ_BIN" -r --arg key "$key" '.data[$key].error? // {} | "\(.message // "It failed.") (\(.code // "FAILED"))"' <<<"$response")" >&2
        # The links of the error, as the other error output prints them (rule 22). An error with a plan link names upgrade_plan.
        "$JQ_BIN" -r --arg key "$key" '.data[$key].error? // {}
          | ((.upgrade_url? // "") | if type == "string" and test("^https?://[^\\s\\p{Cc}]+$") then . else "" end) as $url
          | ((.next_action? // (if $url != "" then "upgrade_plan" else "" end)) | if type == "string" and test("^[a-z_]{1,64}$") then . else "" end) as $next
          | (if $url != "" then "Upgrade: \($url)" else empty end), (if $next != "" then "Next action: \($next)" else empty end)' <<<"$response" >&2 2>/dev/null || true
        return 1 ;;
    esac
    if (( SECONDS - started >= WORK_WAIT_SECONDS )); then
      "$JQ_BIN" -c --arg key "$key" --argjson last "$response" '.data[$key] = $last.data[$key]' <<<"$first"
      echo "Still $status after ${WORK_WAIT_SECONDS}s. Read it again later." >&2
      return 2
    fi
    waiting="$("$JQ_BIN" -r --arg key "$key" '.data[$key].waiting_for? // empty' <<<"$response")"
    if [[ "$status${waiting:+ $waiting}" != "$shown" ]]; then
      shown="$status${waiting:+ $waiting}"
      echo "Waiting: $status${waiting:+ (waits for $waiting)}" >&2
    fi
    sleep "$WORK_WAIT_INTERVAL"
    response="$(http_json GET "$path" "{}")" || return 1
  done
}

http_json_quiet() {
  local method="$1"
  local path="$2"
  local payload="$3"
  local body_file status message code agent_args=()
  LAST_HTTP_STATUS=""
  LAST_ERROR_CODE=""
  LAST_ERROR_MESSAGE=""
  LAST_ERROR_DETAILS_JSON=""
  body_file="$(mktemp)"

  while IFS= read -r -d '' value; do
    agent_args+=("$value")
  done < <(agent_header_args)

  if ! status="$(safe_curl -sS -o "$body_file" -w "%{http_code}" -X "$method" --url "$(api_url "$path")" "${agent_args[@]}" -H "Content-Type: application/json" --data "$payload")"; then
    rm -f "$body_file"
    LAST_HTTP_STATUS=""
    LAST_ERROR_CODE="NETWORK_ERROR"
    LAST_ERROR_MESSAGE="Network error while calling $path"
    LAST_ERROR_DETAILS_JSON=""
    return 1
  fi

  if http_status_success "$status"; then
    cat "$body_file"
    rm -f "$body_file"
    return 0
  fi

  message="$("$JQ_BIN" -r 'if (.error | type) == "object" then (.error.message // empty) else (.error_description // .message // empty) end' "$body_file" 2>/dev/null || true)"
  code="$("$JQ_BIN" -r 'if (.error | type) == "object" then (.error.code // empty) else (.error // empty) end' "$body_file" 2>/dev/null || true)"
  LAST_HTTP_STATUS="$status"
  LAST_ERROR_CODE="$code"
  LAST_ERROR_MESSAGE="$message"
  LAST_ERROR_DETAILS_JSON="$("$JQ_BIN" -c 'if (.error | type) == "object" then (.error.details // {}) else {} end' "$body_file" 2>/dev/null || printf '{}')"
  rm -f "$body_file"
  return 1
}

prompt_read() {
  local prompt="$1"
  local value
  if [[ -t 0 ]]; then
    printf "%s" "$prompt" >&2
    IFS= read -r value
  elif { exec 3<>/dev/tty; } 2>/dev/null; then
    printf "%s" "$prompt" >&3
    IFS= read -r value <&3
    exec 3>&-
  else
    die "Browser login could not start, and the email-code fallback needs an interactive terminal. Retry 'revdoku login' in a terminal."
  fi
  printf "%s" "$value"
}

save_api_key() {
  local key="$1"
  [[ -n "$key" ]] || die "API key is required"
  [[ "$key" != *[[:cntrl:]]* ]] || die "invalid credential"
  printf "%s\n" "$key" | atomic_private_write "$CREDENTIALS_PATH" || return 1
  rm -f "$DEFAULT_PROJECT_PATH"
  echo "Saved Revdoku API key to $CREDENTIALS_PATH" >&2
  echo "This is a one-time setup. Future runs will reuse the saved key automatically." >&2
  API_KEY="$key"
}

open_browser_url() {
  local url="$1"
  validate_api_url "$url"
  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 && return 0
  fi
  if command -v wslview >/dev/null 2>&1; then
    wslview "$url" >/dev/null 2>&1 && return 0
  fi
  return 1
}

# Open the selected project in the authenticated dashboard.
open_dashboard() {
  if [[ -n "$PROJECT_ID" ]]; then
    BROWSER_LOGIN_PATH="/projects/view?id=$PROJECT_ID"
  else
    BROWSER_LOGIN_PATH="/projects"
  fi
  browser_login_link
}

request_device_agent_key() {
  local payload response response_file client_id device_code user_code verification_uri_complete expires_in interval deadline now token_payload key signup_medium

  signup_medium=cli
  [[ "${REVDOKU_SIGNUP_MEDIUM:-}" == "skill" ]] && signup_medium=skill

  payload="$("$JQ_BIN" -nc --arg grant "$DEVICE_CODE_GRANT_TYPE" '{client_name:"Revdoku CLI", redirect_uris:[], grant_types:[$grant,"refresh_token"], response_types:[], token_endpoint_auth_method:"none"}')"
  response="$(http_json_quiet POST "/oauth/register" "$payload")" || return 1
  client_id="$("$JQ_BIN" -r '.client_id // empty' <<<"$response")"
  [[ -n "$client_id" ]] || return 1

  payload="$("$JQ_BIN" -nc --arg client_id "$client_id" --arg resource "$MCP_RESOURCE" --arg signup_medium "$signup_medium" '{client_id:$client_id, scope:"revdoku:mcp", resource:$resource, signup_medium:$signup_medium}')"
  response="$(http_json_quiet POST "/oauth/device_authorization" "$payload")" || return 1
  device_code="$("$JQ_BIN" -r '.device_code // empty' <<<"$response")"
  user_code="$("$JQ_BIN" -r '.user_code // empty' <<<"$response")"
  verification_uri_complete="$("$JQ_BIN" -r '.verification_uri_complete // .verification_uri // empty' <<<"$response")"
  expires_in="$("$JQ_BIN" -r '.expires_in // 600' <<<"$response")"
  interval="$("$JQ_BIN" -r '.interval // 5' <<<"$response")"
  [[ -n "$device_code" && -n "$user_code" && -n "$verification_uri_complete" ]] || return 1
  [[ "$expires_in" =~ ^[0-9]+$ && "$expires_in" -gt 0 ]] || expires_in=600
  [[ "$interval" =~ ^[0-9]+$ && "$interval" -gt 0 ]] || interval=5

  validate_api_url "$verification_uri_complete"
  echo "Open this Revdoku link to connect:" >&2
  echo "$verification_uri_complete" >&2
  echo "Connection ID is $user_code" >&2
  echo "This is a safety check. Make sure the same ID appears in the top-right of Revdoku, then select Connect." >&2
  if open_browser_url "$verification_uri_complete"; then
    echo "Opened the approval page in your browser." >&2
  else
    echo "Could not open a browser automatically; paste the link above into your browser." >&2
  fi
  echo "Waiting for browser approval..." >&2

  deadline=$(( $(date +%s) + expires_in ))
  response_file="$(mktemp)"
  while true; do
    now="$(date +%s)"
    if [[ "$now" =~ ^[0-9]+$ && "$now" -ge "$deadline" ]]; then
      rm -f "$response_file"
      die "device login expired; run 'revdoku login' again"
    fi

    sleep "$interval"
    token_payload="$("$JQ_BIN" -nc --arg grant "$DEVICE_CODE_GRANT_TYPE" --arg client_id "$client_id" --arg device_code "$device_code" --arg resource "$MCP_RESOURCE" '{grant_type:$grant, client_id:$client_id, device_code:$device_code, resource:$resource}')"
    : > "$response_file"
    # Keep http_json_quiet in this shell. Command substitution would run it in a
    # subshell and discard LAST_ERROR_CODE, turning the expected
    # authorization_pending response into a false legacy-login fallback.
    if http_json_quiet POST "/oauth/token" "$token_payload" > "$response_file"; then
      response="$(cat "$response_file")"
      key="$("$JQ_BIN" -r '.revdoku_api_key // empty' <<<"$response")"
      [[ -n "$key" ]] || die "device login did not return a Revdoku API key"
      save_api_key "$key" || return 1
      rm -f "$response_file"
      return 0
    fi

    case "$LAST_ERROR_CODE" in
      authorization_pending)
        ;;
      slow_down)
        interval=$((interval + 5))
        ;;
      access_denied)
        rm -f "$response_file"
        die "Revdoku connection was denied in the browser"
        ;;
      expired_token)
        rm -f "$response_file"
        die "device login expired; run 'revdoku login' again"
        ;;
      *)
        rm -f "$response_file"
        return 1
        ;;
    esac
  done
}

request_email_agent_key() {
  local email code payload response key

  while true; do
    email="$(prompt_read "Email: ")"
    [[ -n "$email" ]] || die "email is required"

    payload="$("$JQ_BIN" -nc --arg email "$email" '{email:$email}')"
    if http_json POST "/api/v1/auth/sign_in_code" "$payload" false >/dev/null; then
      break
    fi

    die "could not start email verification"
  done

  echo "If $email can receive Revdoku sign-in codes, a verification code was sent." >&2
  echo "If no code arrives, sign in at $APP_URL/users/sign_in or retry browser device sign-in with 'revdoku login'." >&2

  code="$(prompt_read "Code: ")"
  [[ -n "$code" ]] || die "code is required"

  payload="$("$JQ_BIN" -nc --arg email "$email" --arg code "$code" '{email:$email, code:$code, label:"Revdoku CLI"}')"
  if ! response="$(http_json POST "/api/v1/auth/sign_in_code/verify" "$payload" false)"; then
    die "Could not verify the code. If no code arrived or the code is rejected, use 'revdoku login' and complete browser device sign-in."
  fi
  key="$("$JQ_BIN" -r '.data.connection.api_key // empty' <<<"$response")"
  [[ -n "$key" ]] || die "verification did not return an API key. Use 'revdoku login' and complete browser device sign-in."

  save_api_key "$key" || return 1
}

request_agent_key() {
  if request_device_agent_key; then
    return
  fi

  echo "Browser device login is unavailable on this Revdoku server; using legacy email-code fallback." >&2
  request_email_agent_key
}

exchange_agent_grant() {
  local token="$1" payload response key account_id account_name
  [[ -n "$token" ]] || die "one-time connection token is required"
  payload="$("$JQ_BIN" -nc --arg grant_token "$token" --arg label "${AGENT_NAME} connection" '{grant_token:$grant_token,label:$label}')"
  response="$(http_json POST "/api/v1/auth/grant/exchange" "$payload" false)" \
    || die "connection token is invalid, expired, or already used"
  key="$("$JQ_BIN" -r '.data.connection.api_key // empty' <<<"$response")"
  account_id="$("$JQ_BIN" -r '.data.connection.account_id // empty' <<<"$response")"
  account_name="$("$JQ_BIN" -r '.data.connection.account_name // empty' <<<"$response")"
  [[ -n "$key" ]] || die "connection response did not include an API key"
  save_api_key "$key" || return 1
  echo "Connected to Revdoku${account_name:+: $account_name}." >&2
  [[ -n "$account_id" ]] && echo "Account: $account_id" >&2
}

if [[ "$ACTION" == "exchange_grant" ]]; then
  exchange_agent_grant "$GRANT_TOKEN"
  echo "Connection complete. You can return to your AI agent." >&2
  exit 0
fi

# Bare `revdoku` with no saved credentials: show a friendly hint instead of
# forcing the interactive login flow.
if [[ "$ACTION" == "connection_status" && "$ORIGINAL_ARGC" -eq 0 && -z "$API_KEY" ]]; then
  echo "Revdoku CLI — not signed in yet." >&2
  echo "  Sign in:   revdoku login" >&2
  echo "  Commands:  revdoku --help" >&2
  exit 0
fi

if [[ "$LOGIN" == "true" || -z "$API_KEY" ]]; then
  request_agent_key
fi

if [[ "$LOGIN" == "true" && -z "$ACTION" ]]; then
  echo "Login complete. Credentials saved to $CREDENTIALS_PATH." >&2
  echo "Next: revdoku ls, or revdoku dashboard." >&2
  exit 0
fi

[[ -n "$API_KEY" ]] || die "REVDOKU_API_KEY is required"
# Build "name=value&..." from name/value pairs, omitting empty values.
query_string() {
  "$JQ_BIN" -rn '$ARGS.positional | [range(0; length; 2) as $i | {key: .[$i], value: .[$i + 1]}]
    | map(select(.value != "") | (.key + "=" + (.value | @uri))) | join("&")' --args "$@"
}

list_projects() {
  http_json GET "/api/v1/projects?$(query_string status "$PROJECT_LIST_STATUS" q "$PROJECT_LIST_QUERY" limit "$LIST_LIMIT" cursor "$LIST_CURSOR")" "{}"
}

# GitHub (REST /projects/ID/github and /account/github/installations): the repository whose branch, or one
# folder of it, is the project's files. A person adds a GitHub account on GitHub: setup-link prints their links.
github_command() {
  local path body query response
  case "$GITHUB_ACTION" in
    accounts|repos)
      query="$(query_string limit "$LIST_LIMIT" cursor "$LIST_CURSOR")"
      path="/api/v1/account/github/installations"
      [[ "$GITHUB_ACTION" == "accounts" ]] || path="${path}/${GITHUB_INSTALLATION_ID}/repositories"
      http_json GET "${path}${query:+?$query}" "{}"
      return
      ;;
  esac
  [[ "$PROJECT_ID" =~ ^prj_[A-Za-z0-9]+$ ]] || die "Provide --project-id ID"
  path="/api/v1/projects/${PROJECT_ID}/github"
  case "$GITHUB_ACTION" in
    get) http_json GET "$path" "{}" ;;
    setup-link) http_json GET "${path}/setup_link" "{}" ;;
    scan)
      # The query of a scan: the fields of a connect. Nothing changes.
      if [[ -n "$GITHUB_REPOSITORY" ]]; then
        query="$(query_string repo_owner "${GITHUB_REPOSITORY%%/*}" repo_name "${GITHUB_REPOSITORY#*/}" branch "$GITHUB_BRANCH" \
          repo_path "$GITHUB_REPO_PATH" installation_id "$GITHUB_INSTALLATION_ID")"
      else
        query="$(query_string branch "$GITHUB_BRANCH" repo_path "$GITHUB_REPO_PATH" installation_id "$GITHUB_INSTALLATION_ID")"
      fi
      http_json GET "${path}/scan${query:+?$query}" "{}" ;;
    sync)
      # A copy that runs already answers GITHUB_SYNC_IN_PROGRESS. That is an error: this command sent no copy.
      response="$(http_json POST "${path}/sync" "{}")" || return 1
      wait_for_work "$path" github "$response" ;;
    branches)
      query="$(query_string limit "$LIST_LIMIT" cursor "$LIST_CURSOR")"
      http_json GET "${path}/branches${query:+?$query}" "{}" ;;
    connect)
      body="$("$JQ_BIN" -n --arg owner "${GITHUB_REPOSITORY%%/*}" --arg name "${GITHUB_REPOSITORY#*/}" --arg branch "$GITHUB_BRANCH" \
        --arg repo_path "$GITHUB_REPO_PATH" --arg installation "$GITHUB_INSTALLATION_ID" \
        --arg files "$GITHUB_PROJECT_FILES" \
        '{repo_owner: $owner, repo_name: $name}
          + (if $branch != "" then {branch: $branch} else {} end)
          + (if $repo_path != "" then {repo_path: $repo_path} else {} end)
          + (if $installation != "" then {installation_id: ($installation | tonumber)} else {} end)
          + (if $files != "" then {project_files: $files} else {} end)')"
      response="$(http_json POST "$path" "$body")" || return 1
      wait_for_work "$path" github "$response"
      ;;
    set)
      [[ -n "$GITHUB_AUTO_PUBLISH" ]] || die "github set needs --auto-publish"
      body="$("$JQ_BIN" -n --arg publish "$GITHUB_AUTO_PUBLISH" '{auto_publish: ($publish == "true")}')"
      http_json PATCH "$path" "$body"
      ;;
    disconnect)
      [[ "$DELETE_CONFIRMATION" == "$PROJECT_ID" ]] || die "Repeat with --confirm-delete $PROJECT_ID to disconnect the repository. The project keeps its files."
      http_json DELETE "$path" "{}"
      ;;
  esac
}

list_files() {
  [[ -n "$PROJECT_ID" ]] || die "files requires --project-id (or a remembered selected project)"
  local query
  query="$(query_string limit "$LIST_LIMIT" cursor "$LIST_CURSOR" folder "$LIST_FOLDER")"
  http_json GET "/api/v1/projects/${PROJECT_ID}/files${query:+?$query}" "{}"
}

# Prints the ID of the current file at READ_FILE_PATH, or the given df_ file ID.
file_id_for_path() {
  local response id
  if [[ "$READ_FILE_PATH" =~ ^df_[A-Za-z0-9]+$ ]]; then
    printf '%s' "$READ_FILE_PATH"
    return 0
  fi
  response="$(http_json GET "/api/v1/projects/${PROJECT_ID}/files/by_path?$(query_string path "$READ_FILE_PATH")" "{}")" || return 1
  id="$("$JQ_BIN" -r '.data.file.id // empty' <<<"$response")"
  validate_id file_id "$id"
  printf '%s' "$id"
}

list_versions() {
  [[ -n "$PROJECT_ID" ]] || die "versions requires --project-id"
