# Fetch data.download.url from an API response. The link carries its own
# authorization: never send the API key to it.
download_link() {
  local response="$1" label="$2" url
  url="$("$JQ_BIN" -er '.data.download.url' <<<"$response")" || die "download response did not include url"
  download_file_url "$url" "$label"
}

# Follow downloads one hop at a time so each destination is checked before use.
download_file_url() {
  local url="$1" label="$2" body_file headers status location hop
  body_file="$(mktemp)"
  headers="$(mktemp)"
  for hop in 0 1 2 3 4 5; do
    if ! validate_transfer_url "$url"; then
      rm -f "$body_file" "$headers"
      die "download destination is not approved"
    fi
    if ! status="$(safe_curl -sS --max-time 120 -D "$headers" -o "$body_file" -w "%{http_code}" \
      -H "Accept: */*" --url "$url")"; then
      rm -f "$body_file" "$headers"
      die "network error while reading file"
    fi
    case "$status" in
      301|302|303|307|308)
        location="$(awk 'tolower($1) == "location:" {sub(/^[^:]*:[ \t]*/, ""); sub(/\r$/, ""); print}' "$headers")"
        [[ "$location" != /* || "$location" == //* ]] || location="${url%%://*}://$(printf '%s' "${url#*://}" | cut -d/ -f1)$location"
        url="$location"
        ;;
      2??)
        rm -f "$headers"
        if [[ -n "$OUTPUT_PATH" ]]; then
          if ! atomic_private_write "$OUTPUT_PATH" < "$body_file"; then
            rm -f "$body_file"
            return 1
          fi
          echo "Saved $label to $OUTPUT_PATH" >&2
        else
          cat "$body_file"
        fi
        rm -f "$body_file"
        return 0
        ;;
      *)
        rm -f "$body_file" "$headers"
        die "failed to read file (HTTP $status)"
        ;;
    esac
  done
  rm -f "$body_file" "$headers"
  die "too many file download redirects"
}

# Support tickets (REST /buckets/ID/tickets): one conversation with a requester, from email or chat (feedback: earlier feedback emails).
# Messages have eml_ IDs; a reply is a new message of the ticket.
ticket_command() {
  [[ -n "$BUCKET_ID" ]] || die "ticket commands require --bucket-id or a bound folder"
  local path="/api/v1/buckets/${BUCKET_ID}/tickets" query response
  if [[ "$ACTION" == "list_tickets" ]]; then
    query="$(query_string limit "$LIST_LIMIT" cursor "$LIST_CURSOR" status "$STATUS_OPTION" channel "$TICKET_CHANNEL" \
      label "$TICKET_LABEL" updated_after "$TICKET_UPDATED_AFTER")"
    http_json GET "${path}${query:+?$query}" "{}"
    return
  fi
  path="${path}/${TICKET_ID}"
  case "$ACTION" in
    ticket)
      http_json GET "$path" "{}"
      ;;
    ticket-messages)
      if [[ -n "$MESSAGE_ID" ]]; then
        [[ -z "$LIST_LIMIT$LIST_CURSOR" ]] || die "--limit and --cursor list messages; omit --message-id"
        http_json GET "${path}/messages/${MESSAGE_ID}" "{}"
      else
        query="$(query_string limit "$LIST_LIMIT" cursor "$LIST_CURSOR")"
        http_json GET "${path}/messages${query:+?$query}" "{}"
      fi
      ;;
    ticket-reply)
      reply_to_ticket "${path}/messages"
      ;;
    ticket-update)
      [[ -n "$STATUS_OPTION$EMAIL_ADD_LABELS$EMAIL_REMOVE_LABELS" || "$TICKET_NOTE_SET" == "true" ]] || die "ticket-update requires --status open|pending|solved, --note, --add-label or --remove-label"
      http_json PATCH "$path" "$("$JQ_BIN" -nc --arg status "$STATUS_OPTION" --arg add "$EMAIL_ADD_LABELS" --arg remove "$EMAIL_REMOVE_LABELS" \
        --arg note "$TICKET_NOTE" --arg note_set "$TICKET_NOTE_SET" '
        def names: split("\n") | map(select(length > 0));
        (if $status == "" then {} else {status: $status} end)
        + (if $note_set == "true" then {internal_note: $note} else {} end)
        + (if ($add | names | length) > 0 then {add_labels: ($add | names)} else {} end)
        + (if ($remove | names | length) > 0 then {remove_labels: ($remove | names)} else {} end)')"
      ;;
    ticket-message-delete)
      [[ -n "$MESSAGE_ID" ]] || die "ticket-message-delete requires --message-id ID (see revdoku ticket-messages $TICKET_ID)"
      [[ "$DELETE_CONFIRMATION" == "$MESSAGE_ID" ]] || die "To delete this message and its attachments, repeat with --confirm-delete $MESSAGE_ID"
      http_json DELETE "${path}/messages/${MESSAGE_ID}" "{}"
      ;;
    ticket-download)
      [[ -n "$MESSAGE_ID" ]] || die "ticket-download requires --message-id ID (see revdoku ticket-messages $TICKET_ID)"
      path="${path}/messages/${MESSAGE_ID}"
      if [[ -n "$EMAIL_ATTACHMENT_ID" ]]; then
        [[ "$EMAIL_ATTACHMENT_ID" =~ ^eat_[A-Za-z0-9]+$ ]] || die "invalid attachment id"
        path="${path}/attachments/${EMAIL_ATTACHMENT_ID}"
      else
        path="${path}/raw"
      fi
      response="$(http_json GET "$path" "{}")" || return 1
      download_link "$response" "$("$JQ_BIN" -r '.data.download.filename // "download"' <<<"$response")"
      ;;
  esac
}

# A reply goes to the ticket's requester: the server chooses the recipient and checks limits and permissions.
reply_to_ticket() {
  local path="$1" text_file html_file payload
  [[ -n "$EMAIL_TEXT" || -n "$EMAIL_TEXT_FILE" ]] || die "ticket-reply requires --text TEXT or --text-file PATH"
  [[ -z "$EMAIL_TEXT" || -z "$EMAIL_TEXT_FILE" ]] || die "Use --text or --text-file, not both"
  [[ -z "$EMAIL_TEXT_FILE" || "$EMAIL_TEXT_FILE" == "-" || -f "$EMAIL_TEXT_FILE" ]] || die "--text-file does not exist: $EMAIL_TEXT_FILE"
  [[ -z "$EMAIL_HTML_FILE" || -f "$EMAIL_HTML_FILE" ]] || die "--html-file does not exist: $EMAIL_HTML_FILE"
  # Bodies go through files: Linux limits one argument to 128 KiB.
  text_file="$(mktemp)"; html_file="$(mktemp)"
  # Expand now: the EXIT trap runs after these locals leave scope.
  trap "rm -f $(printf '%q ' "$text_file" "$html_file")" EXIT
  if [[ "$EMAIL_TEXT_FILE" == "-" ]]; then
    cat > "$text_file"
  elif [[ -n "$EMAIL_TEXT_FILE" ]]; then
    cat "$EMAIL_TEXT_FILE" > "$text_file"
  else
    printf "%s" "$EMAIL_TEXT" > "$text_file"
  fi
  [[ -z "$EMAIL_HTML_FILE" ]] || cat "$EMAIL_HTML_FILE" > "$html_file"
  payload="$("$JQ_BIN" -nc --rawfile text "$text_file" --rawfile html "$html_file" \
    --arg attachments "$EMAIL_ATTACHMENTS" --arg subject "$EMAIL_SUBJECT" '
    def list: split("\n") | map(select(. != ""));
    {subject: $subject, text: $text, html: (if $html == "" then null else $html end),
      attachment_ids: ($attachments | list)}
    | with_entries(select(.value != null and .value != "" and .value != []))')" || payload=""
  rm -f "$text_file" "$html_file"
  [[ -n "$payload" ]] || die "Could not read the reply body"
  if ! http_json POST "$path" "$payload"; then
    # EMAIL_LABELING_PENDING refuses the reply before anything is stored.
    if [[ -z "$LAST_HTTP_STATUS" || "$LAST_HTTP_STATUS" == 5* ]] && [[ "$LAST_ERROR_CODE" != "EMAIL_LABELING_PENDING" ]]; then
      echo "The reply result is unknown. Do not reply again until 'revdoku ticket-messages $TICKET_ID --bucket-id $BUCKET_ID' confirms it was not sent." >&2
    fi
    return 1
  fi
}

create_bucket() {
  local payload
  payload="$("$JQ_BIN" -nc --arg description "$DESCRIPTION" --arg title "$BUCKET_TITLE" \
    --arg username "$EMAIL_USERNAME" --arg domain "$EMAIL_DOMAIN" \
    --argjson metadata "$METADATA_JSON" \
    '{bucket: (({title:$title,description:$description} | with_entries(select(.value != ""))) +
      (if ($metadata | length) > 0 then {metadata: $metadata} else {} end) +
      {email: ({username:$username,domain:$domain} | with_entries(select(.value != "")))})}')"
  http_json POST "/api/v1/buckets" "$payload"
}

publish_request_body() {
  local source="/dev/null"
  if [[ -n "$PASSWORD_FILE" ]]; then
    if [[ "$PASSWORD_FILE" == "-" ]]; then
      source="/dev/stdin"
    else
      [[ -f "$PASSWORD_FILE" && ! -L "$PASSWORD_FILE" ]] || die "--password-file must be a regular file"
      source="$PASSWORD_FILE"
    fi
  fi
  # --rawfile keeps the password out of the process arguments.
  "$JQ_BIN" -n --arg mode "$ACCESS_MODE" --arg branch "$([[ "$ACTION" == "preview" ]] && printf '%s' "$GITHUB_BRANCH")" --rawfile password "$source" \
    '($password | rtrimstr("\n") | rtrimstr("\r")) as $value
     | (if $mode == "" then {} else {access_mode: $mode} end) + (if $value == "" then {} else {password: $value} end)
       + (if $branch == "" then {} else {branch: $branch} end)'
}

archive_bucket() {
  [[ -n "$BUCKET_ID" ]] || die "archive requires --bucket-id"
  http_json POST "/api/v1/buckets/${BUCKET_ID}/archive" "{}"
}

unarchive_bucket() {
  [[ -n "$BUCKET_ID" ]] || die "unarchive requires --bucket-id"
  http_json POST "/api/v1/buckets/${BUCKET_ID}/unarchive" "{}"
}

delete_bucket() {
  local bucket_response account_response state token directory path claimed now expires payload response
  directory="$REVDOKU_CONFIG_DIR/delete-confirmations"
  [[ ! -L "$directory" ]] || die "refusing symlink confirmation storage"
  if [[ -d "$directory" ]]; then
    directory="$(cd -P -- "$directory" && pwd -P)"
  fi
  now="$(date +%s)"
  if [[ -n "$DELETE_CONFIRMATION" ]]; then
    [[ "$DELETE_CONFIRMATION" =~ ^[a-f0-9]{64}$ ]] || die "invalid deletion preview token"
    path="$directory/$DELETE_CONFIRMATION.json"
    [[ -f "$path" && ! -L "$path" ]] || die "deletion preview is missing or already consumed"
    "$JQ_BIN" -e --argjson now "$now" --arg origin "$BASE_URL" --arg account "$ACCOUNT_ID" --arg bucket "$BUCKET_ID" \
      '.expires_at > $now and .state.origin == $origin and .state.account.id == $account and .state.bucket.id == $bucket' "$path" >/dev/null || die "deletion preview expired or targets differ; preview again"
  fi
  bucket_response="$(http_json GET "/api/v1/buckets/${BUCKET_ID}" "{}")" || return 1
  account_response="$(http_json GET "/api/v1/accounts/${ACCOUNT_ID}" "{}")" || return 1
  # The preview binds the confirmation to the file-tree version, the settings
  # version and the counts. Any change between preview and confirm stops it.
  state="$(printf '%s\n%s\n' "$bucket_response" "$account_response" | "$JQ_BIN" -csS --arg origin "$BASE_URL" '
    .[0].data.bucket as $b | .[1].data.account as $account |
    if (($b.metadata_version | type == "string" and length > 0) and
        ($b | has("version_id")) and ($b.version_id | . == null or type == "string") and
        ($b.version_number | type == "number") and ($b.files_count | type == "number")) | not
    then error("Incomplete bucket deletion state; update the client or review in the dashboard") else
    {origin:$origin, account:($account | {id,name}),
     bucket:($b | {id, email:{address:.email.address}, account_id, archived, archived_at, metadata_version,
       version_id, version_number, files_count, storage_bytes, delete, dashboard_url})}
    end')" || return 1
  "$JQ_BIN" -e --arg account "$ACCOUNT_ID" --arg bucket "$BUCKET_ID" '
    .account.id == $account and .bucket.id == $bucket and
    (.bucket.account_id == null or .bucket.account_id == $account) and
    .bucket.archived == true and .bucket.delete.allowed == true and (.bucket.delete.confirmation | type == "string" and length > 0)' <<<"$state" >/dev/null || die "bucket is not eligible for deletion in the selected account; review its action guidance in the dashboard"

  if [[ -z "$DELETE_CONFIRMATION" ]]; then
    mkdir -p -- "$directory"
    [[ ! -L "$directory" ]] || die "refusing symlink confirmation storage"
    directory="$(cd -P -- "$directory" && pwd -P)"
    chmod 0700 "$directory"
    token="$(openssl rand -hex 32)"
    expires=$((now + 600))
    "$JQ_BIN" -cn --argjson state "$state" --argjson expires "$expires" \
      '{state:$state,expires_at:$expires}' | atomic_private_write "$directory/$token.json"
    "$JQ_BIN" -cn --argjson state "$state" --arg token "$token" --argjson expires "$expires" \
      '$state | del(.bucket.delete.confirmation) | {success:true, data:(. + {
        preview:true, irreversible:true, confirmation_token:$token, expires_at:$expires,
        dashboard_url:.bucket.dashboard_url,
        notice:"Permanently deletes this bucket, its emails, files and versions. Obtain user approval for this exact target before --confirm-delete."})}'
    return 0
  fi

  "$JQ_BIN" -e --argjson state "$state" --argjson now "$(date +%s)" '.state == $state and .expires_at > $now' "$path" >/dev/null || die "bucket deletion state changed; preview again"
  claimed="$(mktemp "$directory/.consumed.XXXXXX")"
  if ! mv "$path" "$claimed" 2>/dev/null; then
    rm -f "$claimed"
    die "deletion preview was already consumed"
  fi
  rm -f "$claimed"
  payload="$("$JQ_BIN" -c '{confirmation:.bucket.delete.confirmation}' <<<"$state")"
  if ! response="$(http_json DELETE "/api/v1/buckets/${BUCKET_ID}" "$payload")"; then
    echo "Deletion was not confirmed. Check bucket status before creating another preview; this token is consumed." >&2
    return 1
  fi
  printf '%s\n' "$response"
}

connection_status() {
  http_json GET "/api/v1/status" "{}" | "$JQ_BIN" -c '{
    success: (.success // true),
    data: {
      connected: (.data.connected // true),
      account: .data.account,
      user: .data.user,
      default_account_id: .data.default_account_id,
      accounts: .data.accounts,
      connection: .data.connection,
      features: .data.features,
      dashboard_url: .data.dashboard_url
    }
  }'
}

create_client_account() {
  local payload
  payload="$("$JQ_BIN" -cn --arg name "$CLIENT_ACCOUNT_NAME" --arg client_name "$CLIENT_DISPLAY_NAME" '{name: $name} + (if $client_name == "" then {} else {client_name: $client_name} end)')"
  http_json POST "/api/v1/accounts" "$payload"
}

account_status() {
  local identity limits
  identity="$(http_json GET "/api/v1/status" "{}")" || return 1
  limits="$(http_json GET "/api/v1/account/limits" "{}")" || return 1
  "$JQ_BIN" -nc --argjson identity "$identity" --argjson limits "$limits" '{
    success: true,
    data: {
      account: $identity.data.account,
      default_account_id: $identity.data.default_account_id,
      accounts: $identity.data.accounts,
      limits: $limits.data.limits,
      usage: $limits.data.usage
    }
  }'
}

print_terminal_link_hint() {
  if [[ -t 2 ]]; then
    echo "Tip: Cmd-click the link on macOS, or Ctrl-click it on Windows/Linux, if your terminal supports clickable links." >&2
  fi
}

browser_login_link() {
  local payload response url redirect_path
  payload="$("$JQ_BIN" -nc --arg redirect_path "$BROWSER_LOGIN_PATH" '{redirect_path:$redirect_path}')"
  response="$(http_json POST "/api/v1/auth/dashboard_link" "$payload")"
  url="$("$JQ_BIN" -r '.data.url // empty' <<<"$response")"
  redirect_path="$("$JQ_BIN" -r '.data.redirect_path // empty' <<<"$response")"
  [[ -n "$url" ]] || die "browser login response did not include url"
  validate_api_url "$url"
  echo "Open Revdoku: $url" >&2
  [[ -n "$redirect_path" ]] && echo "Destination: $redirect_path" >&2
  echo "Sign in normally if your browser does not already have a Revdoku session." >&2
  print_terminal_link_hint
  printf "%s\n" "$url"
}

# Best-effort, throttled (~24h), never-blocking notice when the server advertises
# a newer client/connector version than the one install.sh stamped. Compares the
# server's /api/v1/status client_version against ~/.revdoku/client_version and
# only nudges when the server version is strictly newer (numeric compare via jq;
# avoids relying on `sort -V`, which is unavailable on busybox/older BSD sort).
maybe_notify_update() {
  [[ -n "$API_KEY" ]] || return 0
  command -v "$JQ_BIN" >/dev/null 2>&1 || return 0

  local now last installed latest body
  now="$(date +%s 2>/dev/null || echo 0)"
  if [[ -f "$UPDATE_CHECK_STAMP" ]]; then
    last="$(cat "$UPDATE_CHECK_STAMP" 2>/dev/null || echo 0)"
    if [[ "$now" -gt 0 && "$last" =~ ^[0-9]+$ && $((now - last)) -lt 86400 ]]; then
      return 0
    fi
  fi
  mkdir -p "$REVDOKU_CONFIG_DIR" 2>/dev/null || true
  printf '%s' "$now" | atomic_private_write "$UPDATE_CHECK_STAMP" 2>/dev/null || true

  installed="$(installed_client_version)"
  [[ "$installed" != "unknown" ]] || return 0
  body="$(safe_curl -fsS --max-time 5 --url "$(api_url "/api/v1/status")" -H "Authorization: Bearer $API_KEY" -H "Accept: application/json" 2>/dev/null || true)"
  [[ -n "$body" ]] || return 0
  latest="$("$JQ_BIN" -r '.data.client_version // empty' <<<"$body" 2>/dev/null || true)"
  [[ -n "$latest" && "$latest" != "$installed" ]] || return 0
  if "$JQ_BIN" -ne --arg inst "$installed" --arg lat "$latest" \
    '($inst | split(".") | map(tonumber? // 0)) < ($lat | split(".") | map(tonumber? // 0))' >/dev/null 2>&1; then
    echo "Revdoku CLI update available (${installed} → ${latest}). Releases: https://github.com/revdoku/revdoku/releases" >&2
  fi
}

[[ "$ACTION" == "delete_bucket" ]] || maybe_notify_update || true

case "$ACTION" in
  webhook|webhook-set|webhook-delete|events-subscription)
    [[ "$BUCKET_ID" =~ ^bkt_[A-Za-z0-9]+$ ]] || die "Provide --bucket-id ID"
    case "$ACTION" in
      webhook) http_json GET "/api/v1/buckets/$BUCKET_ID/webhook" "{}" ;;
      webhook-set)
        [[ -n "$WEBHOOK_URL" ]] || die "Provide --webhook-url HTTPS_URL"
        http_json PUT "/api/v1/buckets/$BUCKET_ID/webhook" "$("$JQ_BIN" -n --arg url "$WEBHOOK_URL" --argjson rotate "$ROTATE_SECRET" '{webhook_url:$url,rotate_secret:$rotate}')" ;;
      webhook-delete)
        [[ "$DELETE_CONFIRMATION" == "$BUCKET_ID" ]] || die "Repeat with --confirm-delete $BUCKET_ID to disable this webhook"
        http_json DELETE "/api/v1/buckets/$BUCKET_ID/webhook" "{}" ;;
      events-subscription) http_json GET "/api/v1/buckets/$BUCKET_ID/events/subscription" "{}" ;;
    esac
    exit 0 ;;
  publish|preview|unpublish|site)
    [[ "$BUCKET_ID" =~ ^bkt_[A-Za-z0-9]+$ ]] || die "Provide --bucket-id ID"
    [[ "$SITE_PREVIEW" != "true" || "$ACTION" == "site" ]] || die "--preview works with site only. Use revdoku preview to publish a preview."
    case "$ACTION" in
      site) http_json GET "/api/v1/buckets/$BUCKET_ID/publication$([[ "$SITE_PREVIEW" == "true" ]] && printf '/preview')" "{}" ;;
      unpublish) http_json DELETE "/api/v1/buckets/$BUCKET_ID/publication" "{}" ;;
      *)
        # A failed password read must stop here: an empty body would publish the site without protection.
        publish_body="$(publish_request_body)" || exit 1
        http_json POST "/api/v1/buckets/$BUCKET_ID/publication$([[ "$ACTION" == "preview" ]] && printf '/preview')" "$publish_body" ;;
    esac
    exit 0 ;;
  github)
    github_command
    exit 0
    ;;
  account_limits)
    http_json GET "/api/v1/account/limits" "{}"
    exit 0
    ;;
  get_account)
    http_json GET "/api/v1/accounts/${ACCOUNT_DETAILS_ID}" "{}"
    exit 0
    ;;
  list_accounts)
    http_json GET "/api/v1/accounts" "{}"
    exit 0
    ;;
  list_tickets|ticket|ticket-messages|ticket-reply|ticket-update|ticket-download|ticket-message-delete)
    ticket_command
    exit 0
    ;;
  create_bucket)
    create_bucket
    exit 0
    ;;
  list_buckets)
    list_buckets
    exit 0
    ;;
  list_files)
    list_files
    exit 0
    ;;
  read_file)
    read_file
    exit 0
    ;;
  list_versions)
    list_versions
    exit 0
    ;;
  write_file)
    write_file
    exit 0
    ;;
  move_file)
    move_file
    exit 0
    ;;
  delete_file)
    delete_file
    exit 0
    ;;
  restore_file)
    restore_file
    exit 0
    ;;
  archive_bucket)
    archive_bucket
    exit 0
    ;;
  unarchive_bucket)
    unarchive_bucket
    exit 0
    ;;
  delete_bucket)
    delete_bucket
    exit 0
    ;;
  create_client_account)
    create_client_account
    exit 0
    ;;
  account_status)
    account_status
    exit 0
    ;;
  connection_status)
    connection_status
    if [[ "$ORIGINAL_ARGC" -eq 0 ]]; then
      echo "Tip: run 'revdoku --help' for all commands." >&2
    fi
    exit 0
    ;;
  open_dashboard)
    open_dashboard
    exit 0
    ;;
esac

die "Choose a command (run 'revdoku --help')"
