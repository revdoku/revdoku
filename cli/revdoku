die() {
  echo "error: $1" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "requires $1"
}

validate_base_url() {
  # Existing configurations using the app origin now use the dedicated API.
  [[ "$BASE_URL" != "$APP_URL" ]] || BASE_URL="$DEFAULT_URL"
  [[ "$BASE_URL" == "$DEFAULT_URL" ]] && return 0
  die "API/auth requests require https://api.revdoku.com"
}

safe_curl() {
  # -q must be the first argument: do not load implicit curl configuration.
  command curl -q --proto '=https' --proto-redir '=https' --globoff "$@"
}

validate_api_url() {
  [[ ( "$1" == "$BASE_URL/"* || "$1" == "$APP_URL/"* ) && "$1" != *[[:space:][:cntrl:]\\]* && "$1" != *'#'* ]] || die "untrusted API/auth URL"
}

validate_transfer_url() {
  local url="$1" rest origin
  [[ "$url" != *[[:space:][:cntrl:]\\]* && "$url" != *'#'* ]] || return 1
  [[ "$url" == "$BASE_URL/"* || "$url" == "$APP_URL/"* ]] && return 0
  [[ "$url" == https://*/* ]] || return 1
  rest="${url#https://}"
  origin="https://${rest%%/*}"
  "$JQ_BIN" -en --arg origin "$origin" '["https://e7218dc0ebb367f99b93a6f839bcd717.eu.r2.cloudflarestorage.com"] | index($origin) != null' >/dev/null
}

validate_id() {
  [[ "$2" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid $1"
}

no_symlink_components() {
  local path="$1"
  while [[ "$path" != / && "$path" != . && -n "$path" ]]; do
    [[ ! -L "$path" ]] || return 1
    path="$(dirname "$path")"
  done
}

# Resolve a caller-selected parent once (including system aliases such as /var),
# keeping the final filename separate so a destination symlink is never followed.
local_file_path() {
  local parent name
  parent="$(dirname -- "$1")"
  name="$(basename -- "$1")"
  parent="$(cd -P -- "$parent" && pwd -P)" || return 1
  printf '%s/%s' "${parent%/}" "$name"
}

atomic_private_write() {
  local path="$1" parent tmp
  [[ ! -L "$path" ]] || die "refusing to write through a symlink"
  [[ ! -e "$path" || -f "$path" ]] || die "destination must be a regular file"
  parent="$(dirname "$path")"
  mkdir -p -- "$parent" || return 1
  path="$(local_file_path "$path")" || return 1
  parent="$(dirname "$path")"
  [[ ! -L "$path" ]] || die "refusing to write through a symlink"
  tmp="$(mktemp "$parent/.revdoku-write.XXXXXX")" || return 1
  if ! cat > "$tmp" || ! chmod 0600 "$tmp" || [[ -L "$path" || ( -e "$path" && ! -f "$path" ) ]] || ! mv -f "$tmp" "$path"; then
    rm -f "$tmp"
    return 1
  fi
}

# Identify the AI agent or tool driving this CLI so uploads are attributed to
# the real caller (claude-code, codex, ...) instead of a generic "cli".
# Precedence: --agent flag / REVDOKU_AGENT_NAME override this entirely; this
# function only runs as the fallback. Always degrades safely to "cli".
detect_agent_name() {
  if [[ -n "${CLAUDECODE:-}" || -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]]; then
    printf 'claude-code'
  elif [[ -n "${CODEX_SANDBOX:-}" || -n "${CODEX_HOME:-}" ]]; then
    printf 'codex'
  elif [[ -n "${CURSOR_TRACE_ID:-}" ]]; then
    printf 'cursor'
  elif [[ -n "${AI_AGENT:-}" ]]; then
    # Generic convention, e.g. AI_AGENT="claude-code_2-1-173_agent" -> "claude-code"
    printf '%s' "${AI_AGENT%%_*}"
  else
    printf 'cli'
  fi
}

