{
  "schema_version": "1.0",
  "name": "Revdoku",
  "description": "Website publishing for AI agents with account-free 24-hour public previews and claimable permanent sites.",
  "homepage": "https://revdoku.com/",
  "docs": "https://revdoku.com/docs",
  "pricing": "https://revdoku.com/pricing.md",
  "api": {
    "catalog": "https://revdoku.com/.well-known/api-catalog",
    "openapi": "https://revdoku.com/openapi.json"
  },
  "mcp": {
    "endpoint": "https://app.revdoku.com/mcp",
    "transport": "streamable-http",
    "anonymous_tools": [
      "website_preview_create",
      "website_preview_update",
      "website_preview_get"
    ],
    "account_authentication": {
      "type": "oauth2",
      "mode": "sign-in-only",
      "account_creation_in_chat": false,
      "signup_url": "https://app.revdoku.com/users/sign_up"
    }
  },
  "anonymous_preview": {
    "account_required": false,
    "public_only": true,
    "private_buckets": false,
    "lifetime_hours": 24,
    "claimable_within_hours": 24,
    "randomized_url": true,
    "max_site_mb": 25,
    "max_file_mb": 25,
    "max_files": 200,
    "forms": false,
    "analytics": false,
    "custom_domains": false,
    "robots": "noindex, nofollow, noarchive, noimageindex",
    "referrer_policy": "no-referrer"
  },
  "skill": {
    "npm": "npx skills add revdoku/revdoku --skill revdoku -g",
    "shell": "curl -fsSL https://revdoku.com/install.sh | bash",
    "source": "https://github.com/revdoku/revdoku/tree/main/skills/revdoku"
  },
  "capabilities": [
    "Create and update an anonymous public website preview",
    "Claim a preview through browser signup",
    "Publish static websites and SPAs from account buckets",
    "Update an existing website at the same URL",
    "Configure protected access, forms, analytics, and domains on eligible plans"
  ],
  "discovery": {
    "agent_card": "https://revdoku.com/.well-known/agent-card.json",
    "plugin_manifest": "https://revdoku.com/.well-known/ai-plugin.json",
    "schema_map": "https://revdoku.com/schema-map.xml",
    "agent_resources": "https://revdoku.com/schema-feeds/agent-resources.jsonl"
  }
}
